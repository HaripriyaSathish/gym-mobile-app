{
  "expo": {
    "name": "PulseForge Fitness",
    "slug": "pulseforge-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulseforge.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5A36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pulseforge.fitness"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "PulseForge Fitness",
      "shortName": "PulseForge",
      "themeColor": "#FF5A36",
      "backgroundColor": "#FFF8F3"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-video",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#FF5A36",
          "defaultChannel": "missed"
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#FFF8F3"
    }
  }
}
