{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "C:/gym mobile app/backend/venv/Scripts/python.exe",
      "runtimeArgs": ["C:/gym mobile app/backend/manage.py", "runserver", "0.0.0.0:8000"],
